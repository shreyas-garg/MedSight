# Copy this file to `.env` and fill in your key:
#   cp .env.example .env
#
# Both variables can live in `.env`. If you prefer to keep the secret separate,
# put GEMINI_API_KEY in `.env.local` instead — Next.js reads both, and neither
# is committed (only this .example file is).

# Local SQLite database. Prisma reads this via prisma.config.ts.
DATABASE_URL="file:./dev.db"

# Google Gemini API key from https://aistudio.google.com/app/apikey
# Newly issued keys start with "AQ." — that is the current format.
GEMINI_API_KEY=your_gemini_api_key_here
